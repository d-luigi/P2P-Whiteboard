# Live sync (see src/sync.ts). All optional.

# Signalling server(s) the browsers use to find each other, comma-separated.
# Default: ws://<this page's hostname>:4444, i.e. the one started by `npm run signal`.
# For use across different networks, run a signalling server on a public host and point
# every browser at it (wss:// if your site is served over https).
# VITE_SIGNALING=wss://signal.example.com

# Optional TURN relay. Without it, ~1 in 5 pairs of networks (strict corporate / mobile NATs)
# can't connect directly. Needed only for those.
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USER=user
# VITE_TURN_CREDENTIAL=secret
