# Live sync settings (see src/sync.ts). Copy to .env.local for local overrides.
# In production, set these in your host's dashboard (e.g. Vercel > Settings > Environment
# Variables) BEFORE building: Vite bakes VITE_* values into the bundle at build time.

# Signalling server(s), comma-separated. Introduces browsers to each other; sees no drawings.
# Default (when unset): ws://<this page's hostname>:4444, i.e. `npm run signal` from the repo root.
# For a deployed site use your public server over TLS:
# VITE_SIGNALING=wss://p2pwb-signaling.onrender.com

# Optional TURN relay, needed when two devices cannot connect directly (typically a phone on
# mobile data). Several URLs may be listed, comma-separated. These end up in the public bundle,
# so use a provider's limited free/demo credentials, not anything precious.
# VITE_TURN_URL=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
# VITE_TURN_USER=your-username
# VITE_TURN_CREDENTIAL=your-credential
